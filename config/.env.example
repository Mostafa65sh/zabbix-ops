# ==============================================================================
# Zabbix Operations UI - Configuration Environment Template
# ==============================================================================
# DO NOT store real production secrets in this template file.
# Copy this file to .env and adjust values for your environment.

# Application Environment (development | production)
APP_ENV=development

# Application Secret Key for session/signing
APP_SECRET=replace_with_a_secure_random_secret_in_production

# Server Binding
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Zabbix Integration
# In production, set to official Zabbix 7.0.5 API endpoint: http://<server>/zabbix/api_jsonrpc.php
ZABBIX_URL=http://127.0.0.1/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=your_zabbix_api_token_here

# Adapter Type: 'mock' for local offline testing, 'real' for production Zabbix
# WARNING: 'mock' must NEVER be used in production!
ZABBIX_ADAPTER_TYPE=mock

# Application Database (Independent from Zabbix DB)
DATABASE_URL=postgresql://zabbix_ops_user:password_placeholder@127.0.0.1:5432/zabbix_ops_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
